{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rezanci",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  // The account ID comes from the CLOUDFLARE_ACCOUNT_ID environment variable, not from this file.
  // No workers.dev address and no preview addresses. Both would be a second way in that
  // the domain rules and the moderator login do not cover.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "rezanci.net", "custom_domain": true }],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Paths under /api/ go to the Worker code. All other paths are static files.
    "run_worker_first": ["/api/*"]
  },
  // Image archive. A lock rule on the locations/ prefix blocks overwrite and delete.
  "r2_buckets": [{ "binding": "ARCHIVE", "bucket_name": "rezanci-archive" }],
  // State store: sessions, enrollments, image records, event log.
  "d1_databases": [
    { "binding": "DB", "database_name": "rezanci", "database_id": "a48a3ac7-a8e0-4177-ae35-4fcec42a2f5f", "migrations_dir": "migrations" }
  ],
  "observability": { "enabled": true }
}
